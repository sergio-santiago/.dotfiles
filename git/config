# ~/.gitconfig
# Global Git configuration with SSH-based commit signing via 1Password.
# - Commits are signed automatically using an SSH key stored in 1Password.
# - Default commit editor is Micro.

[user]
	name = Sergio Santiago
	email = sergio@secture.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIN3Uo9wcjJLsXcEcJ85BxA8ZHEJe670weClg+rOwSSWo

[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

[commit]
	gpgsign = true

[core]
	editor = micro

# Override identity for Tribbu client repos under ~/Projects/tribbu/
[includeIf "gitdir:~/Projects/tribbu/"]
	path = ~/.dotfiles/git/config-tribbu

# Override identity for personal projects under ~/Projects/personal/
[includeIf "gitdir:~/Projects/personal/"]
	path = ~/.dotfiles/git/config-personal
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
