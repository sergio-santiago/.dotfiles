# ~/.config/git/config
# Global Git configuration with SSH-based commit signing via 1Password.
# - Commits are signed automatically using an SSH key stored in 1Password.
# - Default commit editor is Micro.

# There is no default address, on purpose, and useConfigOnly makes git refuse to
# commit until a rule below picks one. Every default has a wrong direction. A work
# default once authored 380-odd commits in public personal repositories with a
# work address, and those stop counting as contributions the day that address
# leaves the GitHub account. A personal default puts a gmail address on work
# commits in any work repo cloned outside its directory. Refusing turns both into
# an error at commit time instead of a silent mistake found months later.
#
# Without useConfigOnly, git would not refuse: it would invent an address from the
# login and the hostname, which is worse than either default.
[user]
	name = Sergio Santiago
	useConfigOnly = true
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIN3Uo9wcjJLsXcEcJ85BxA8ZHEJe670weClg+rOwSSWo

[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	# Which key is trusted for which address, so `git log --show-signature` and
	# `git verify-commit` can check signatures locally. This one is git/allowed_signers,
	# symlinked, with the personal address only. identity-work points work directories
	# at a private copy that names the work address. Without a signers file git still
	# signs, it only cannot verify.
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true

[core]
	editor = micro

# Work identities live outside this public repo, in ~/.config/git/config.private
# (backed up by the private repo). git skips an include whose file is missing, so
# on a machine without it a work repo has no address and git refuses to commit,
# rather than signing with the wrong one.
[include]
	path = ~/.config/git/config.private

# The personal address, for the places that are personal. The last two are
# personal and public and live outside ~/Projects, so they need a rule of their
# own. Any other directory gets no address and git refuses to commit there.
[includeIf "gitdir:~/Projects/personal/"]
	path = ~/.dotfiles/git/config-personal

[includeIf "gitdir:~/.dotfiles/"]
	path = ~/.dotfiles/git/config-personal

[includeIf "gitdir:~/.dotfiles-private/"]
	path = ~/.dotfiles/git/config-personal

# HTTPS credentials for GitHub, delegated to the gh CLI. Written by `gh auth login`.
# The empty `helper =` is load-bearing and not a leftover: helper is a multi-valued
# key, so an empty value resets the list and stops any helper inherited from a system
# or earlier config from being consulted first. Absolute path because git runs helpers
# through a shell that may not have Homebrew on PATH.
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
