#!/usr/bin/env bash
################################################################################
# speak. Read Claude Code replies out loud, when you ask for it
#
#   Named `speak`, not `voice`: Claude Code's own /voice is dictation (it listens
#   to you). This is the opposite direction, and reusing the word for both would
#   be a coin flip every time.
#
#   A plain executable rather than a fish function, so it also works from inside
#   Claude Code via `! speak …`, where `!` runs under bash.
#
# Usage:
#   speak                 toggle this console on/off
#   speak on | off        set explicitly
#   speak summary         read the last reply's summary out loud
#   speak full            read the whole last reply out loud
#   speak stop            shut up right now
#   speak test [text]     check that audio works at all
#
# Voice and speed are hand-edited in ~/.claude/speak.conf, which does not exist
# until you create it. These are the built-in defaults:
#   voice=es_ES-davefx-medium     any model in ~/.local/share/piper/voices
#   speed=1.0                     <1 faster, >1 slower
#   max_chars=11600               caps both the summary and the full text
################################################################################

set -uo pipefail

LIB="$HOME/.claude/speak-lib.sh"
if [[ ! -r "$LIB" ]]; then
  echo "speak: missing $LIB. Run 'make link' in ~/.dotfiles" >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$LIB"

if [[ -t 1 ]]; then
  DIM=$'\033[2m'; RESET=$'\033[0m'
  GREEN=$'\033[38;2;68;243;115m'; YELLOW=$'\033[38;2;255;236;153m'
  RED=$'\033[38;2;255;77;77m'
else
  DIM=""; RESET=""; GREEN=""; YELLOW=""; RED=""
fi

# Confirms a state change. Not exposed as a `status` subcommand: the status line
# already shows whether a console is on, and voice, speed and length live in a
# hand-edited config file, there was nothing left worth asking for.
report_state() {
  if speak_is_on; then
    printf "  %s● this console is on%s\n" "$GREEN" "$RESET"
  else
    printf "  %s○ this console is off%s\n" "$DIM" "$RESET"
  fi

  [[ -x "$SPEAK_PIPER_PY" ]] ||
    printf "  %s! Piper is not installed. Run 'make speak-setup' in ~/.dotfiles%s\n" "$YELLOW" "$RESET"
}

# Read one of the saved versions of the last reply, starting now.
#
# Every branch says something and every branch succeeds. Three states look alike
# from the outside and need different remedies, and "nothing saved yet. Send a
# message first" is a dead end in two of them.
say() {
  local path
  if ! speak_is_on; then
    printf "  %s○ this console is off. Turn it on first%s\n" "$DIM" "$RESET"
    return 0
  fi
  path="$(speak_last_path "$1")"
  if [[ -s "$path" ]]; then
    if speak_say_file "$path"; then
      printf "  %s󰕾 reading%s\n" "$GREEN" "$RESET"
    else
      printf "  %s✗ could not speak. See ~/.claude/speak.log%s\n" "$RED" "$RESET"
    fi
  elif [[ "$1" == .summary && -s "$(speak_last_path .txt)" ]]; then
    printf "  %s○ that reply carried no summary. Read it in full instead%s\n" "$DIM" "$RESET"
  elif [[ "$1" == .txt && -s "$(speak_last_path .summary)" ]]; then
    printf "  %s○ that reply was all code outside its summary. Read the summary instead%s\n" "$DIM" "$RESET"
  else
    printf "  %s○ nothing saved yet. Send a message first%s\n" "$DIM" "$RESET"
  fi
}

# Turns spent running `speak` are bookkeeping: the reply is one line of
# confirmation, and saving it would overwrite the answer you wanted to hear. The
# Stop hook takes this mark and skips the turn.
#
# Only when nothing is attached to stdout, which is how we know we are inside
# Claude Code. Marked unconditionally, `speak on` typed in the pane *before*
# launching claude left a mark that swallowed the first real reply, and the
# advice offered then, "send a message first", was the one thing that could not
# help. The prompt hook clears any mark a turn left unconsumed, belt and braces.
#
# The obvious tidier idea, letting the prompt hook write the mark since it already
# recognises these commands, does not work: measured, UserPromptSubmit does not
# fire for `! command` bash-mode input, so on that path no hook runs at all. This
# test is the only signal there is.
[[ -t 1 ]] || speak_admin_mark

case "${1:-}" in
  '')
    if speak_is_on; then speak_turn_off; else speak_turn_on; fi
    report_state
    ;;

  on)
    speak_turn_on
    report_state
    ;;

  off)
    speak_turn_off
    speak_hush
    report_state
    ;;

  summary)
    say .summary
    ;;

  full)
    say .txt
    ;;

  stop)
    speak_hush
    echo "  ✓ stopped"
    ;;

  test)
    if [[ ! -x "$SPEAK_PIPER_PY" ]]; then
      printf "  %s✗ Piper is not installed. Run 'make speak-setup'%s\n" "$RED" "$RESET"
      exit 0
    fi
    tmp="$(mktemp -t claude-speak-test)" || exit 0
    if [[ $# -gt 1 ]]; then printf '%s\n' "${*:2}" >"$tmp"; else
      printf '%s\n' "Prueba de voz. Si oyes esta frase, la lectura funciona." >"$tmp"
    fi
    if speak_say_file "$tmp"; then
      printf "  %s󰕾 speaking%s\n" "$GREEN" "$RESET"
    else
      printf "  %s✗ could not speak. See ~/.claude/speak.log%s\n" "$RED" "$RESET"
    fi
    rm -f "$tmp"   # speak_say_file already took its own copy
    ;;

  -h | --help | help)
    sed -n '/^# Usage:/,/^#####/p' "$0" | sed 's/^# \{0,1\}//; $d'
    ;;

  *)
    # Exit 0, like every other branch: a non-zero status makes Claude Code abort
    # the turn with a red "shell command failed" and swallow the line below, so a
    # typo would hide the very message that corrects it. Only failing to load the
    # library is worth an error, nothing works at all after that.
    echo "  usage: speak [on|off|summary|full|stop|test <text>]"
    ;;
esac
